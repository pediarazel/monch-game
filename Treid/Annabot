//+------------------------------------------------------------------+
//|                       EMA50_EMA200_Cross_TP200_v4.mq5            |
//|   Cross DOWN (50 above -> below 200) = BUY   TP=EMA200 SL=TP/2   |
//|   Cross UP   (50 below -> above 200) = SELL  TP=EMA200 SL=TP/2   |
//+------------------------------------------------------------------+
#property copyright "Copyright 2026, GapGPT"
#property version   "4.00"
#property strict

#include <Trade\Trade.mqh>

// --- Trading ---
input group "=== Trading Settings ==="
input double   InpLot            = 0.05;      // Lot Size
input double   InpSLRatio        = 0.5;       // SL = TP distance x this (0.5 = half)
input int      InpMinTPPoints    = 20;        // Min TP distance (points) - skip tiny
input int      InpMaxTPPoints    = 3000;      // Max TP distance (points)
input double   InpMaxSlippage    = 10.0;      // Max slippage vs close (points)
input ulong    InpMagicNumber    = 20261111;  // Magic Number

// --- Indicators ---
input group "=== Indicator Settings ==="
input int      InpFastPeriod     = 50;
input int      InpSlowPeriod     = 200;

// --- Globals ---
CTrade   trade;
int      hFast, hSlow;
datetime g_lastBar = 0;

//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(20);
   trade.SetTypeFillingBySymbol(_Symbol);

   hFast = iMA(_Symbol, _Period, InpFastPeriod, 0, MODE_EMA, PRICE_CLOSE);
   hSlow = iMA(_Symbol, _Period, InpSlowPeriod, 0, MODE_EMA, PRICE_CLOSE);

   if(hFast == INVALID_HANDLE || hSlow == INVALID_HANDLE)
   {
      Print("Indicator handle error");
      return(INIT_FAILED);
   }
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(hFast);
   IndicatorRelease(hSlow);
}

//+------------------------------------------------------------------+
bool HasOpenPosition()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!PositionSelectByTicket(PositionGetTicket(i))) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == (long)InpMagicNumber)
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
void OnTick()
{
   datetime barTime = iTime(_Symbol, _Period, 0);
   if(barTime == g_lastBar) return;          // once per new bar
   g_lastBar = barTime;

   if(HasOpenPosition()) return;

   // ---- shift=1 => index 0 is the JUST-CLOSED candle ----
   double e50[], e200[];
   ArraySetAsSeries(e50,  true);
   ArraySetAsSeries(e200, true);

   if(CopyBuffer(hFast, 0, 1, 3, e50)  < 3) return;
   if(CopyBuffer(hSlow, 0, 1, 3, e200) < 3) return;

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, _Period, 1, 1, r) < 1) return;

   double sigClose = r[0].close;      // close of the breakout candle
   double ema200   = e200[0];         // EMA200 on the SAME candle  -> TP target

   // ---- Cross detection on the breakout candle ----
   // crossDown: 50 was ABOVE 200, now BELOW  -> user wants BUY
   // crossUp  : 50 was BELOW 200, now ABOVE  -> user wants SELL
   bool crossDown = (e50[1] >= e200[1] && e50[0] < e200[0]);
   bool crossUp   = (e50[1] <= e200[1] && e50[0] > e200[0]);
   if(!crossDown && !crossUp) return;

   double pt     = _Point;
   double ask    = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid    = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double maxSlp = InpMaxSlippage * pt;

   //==================================================================
   // BUY: EMA50 crossed DOWN through EMA200
   //      price is BELOW EMA200 -> TP = EMA200 (above price)
   //==================================================================
   if(crossDown)
   {
      double tpDist = ema200 - sigClose;         // distance from close up to EMA200
      if(tpDist <= 0) return;                    // sanity
      if(tpDist < InpMinTPPoints * pt || tpDist > InpMaxTPPoints * pt) return;

      double slDist = tpDist * InpSLRatio;       // half of TP
      double sl     = sigClose - slDist;
      double tp     = ema200;

      if(ask - sigClose > maxSlp) return;        // market ran too far

      if(trade.Buy(InpLot, _Symbol, ask, sl, tp, "Cross DOWN -> BUY"))
         PrintFormat("BUY  close=%.5f SL=%.5f TP=%.5f tpDist=%.1f slDist=%.1f pts slip=%.1f",
                     sigClose, sl, tp, tpDist/pt, slDist/pt, (ask - sigClose)/pt);
   }
   //==================================================================
   // SELL: EMA50 crossed UP through EMA200
   //       price is ABOVE EMA200 -> TP = EMA200 (below price)
   //==================================================================
   else
   {
      double tpDist = sigClose - ema200;         // distance from close down to EMA200
      if(tpDist <= 0) return;
      if(tpDist < InpMinTPPoints * pt || tpDist > InpMaxTPPoints * pt) return;

      double slDist = tpDist * InpSLRatio;
      double sl     = sigClose + slDist;
      double tp     = ema200;

      if(sigClose - bid > maxSlp) return;

      if(trade.Sell(InpLot, _Symbol, bid, sl, tp, "Cross UP -> SELL"))
         PrintFormat("SELL close=%.5f SL=%.5f TP=%.5f tpDist=%.1f slDist=%.1f pts slip=%.1f",
                     sigClose, sl, tp, tpDist/pt, slDist/pt, (sigClose - bid)/pt);
   }
}
//+------------------------------------------------------------------+
