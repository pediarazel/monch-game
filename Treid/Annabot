input double InpMaxLot                = 1.0;        // سقف ایمنی حجم لات
input double InpMinLotGuard           = 0.01;       // حداقل مجاز محافظتی؛ در صورت نیاز با حداقل بروکر تطبیق داده می‌شود
input double InpRiskReward            = 2.0;        // نسبت سود به زیان برای حد سود
input int    InpNYHour                = 10;         // ساعت کندل مرجع در نیویورک
input bool   InpAutoNYOffset          = true;       // محاسبه خودکار آفست نیویورک با درنظرگرفتن DST
input int    InpServerOffsetFromNY    = 7;          // فقط در صورت خاموش‌بودن آفست خودکار استفاده می‌شود
input int    InpSessionWindowHours    = 3;          // مدت اعتبار ستاپ پس از کندل مرجع
input int    InpSlippage              = 3;          // انحراف مجاز بر حسب پوینت
input int    InpSLBufferPoints        = 50;         // فاصله حدضرر از مرز بدنه کندل مرجع
input int    InpFvgSLBufferPoints     = 30;         // فاصله حدضرر از ناحیه FVG/پین‌بار
input bool   InpDebugLog              = true;       // ثبت گزارش تشخیصی
input long   InpMagic                 = 123456;     // مجیک نامبر معاملات اکسپرت

