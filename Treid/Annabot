//+------------------------------------------------------------------+
//| Anna Strategy Expert Advisor - XAUUSD.zero                       |
//| Reconstructed Anna-style session liquidity / breakout EA.        |
//| Attach to an M15 chart. Test on demo before live use.             |
//+------------------------------------------------------------------+
#property strict
#property version   "1.00"
#property description "Anna-style session liquidity EA for XAUUSD.zero"

#include <Trade/Trade.mqh>
CTrade trade;

input string          InpSymbol              = "XAUUSD.zero";
input ENUM_TIMEFRAMES InpSignalTimeframe     = PERIOD_M15;
input double          InpLots                = 0.05;
input double          InpMinStopUSD          = 1.00;  // Gold price units, not account-currency loss
input double          InpMaxStopUSD          = 1.50;
input double          InpRewardRisk          = 2.00;
input double          InpBigBodyATRMultiple  = 1.20;
input int             InpATRPeriod           = 14;
input ulong           InpMagic               = 26102501;
input int             InpDeviationPoints     = 30;
input bool            InpEnableAsia          = true;
input bool            InpEnableLondon        = true;
input bool            InpEnableNewYork       = true;
// Session hours are interpreted in BROKER SERVER TIME. Adjust for broker/DST.
input int             InpAsiaStartHour       = 20;
input int             InpAsiaEndHour         = 2;
input int             InpLondonStartHour     = 2;
input int             InpLondonEndHour       = 8;
input int             InpNewYorkStartHour    = 8;
input int             InpNewYorkEndHour      = 12;
// EA cannot remove spread or set broker commission. This is only a note/estimate.
input double          InpEstimatedCommissionUSDPerTrade = 1.00;

int      atrHandle = INVALID_HANDLE;
datetime lastBarTime = 0;
int      currentSession = -1;
bool     haveRange = false;
double   rangeHigh = 0.0, rangeLow = 0.0;
bool     havePreviousSession = false;
double   previousHigh = 0.0, previousLow = 0.0;

// Return session index: 0 Asia, 1 London, 2 New York; -1 outside configured sessions.
int GetSession(datetime t)
{
   MqlDateTime x; TimeToStruct(t,x);
   int h=x.hour;
   bool asia=(InpAsiaStartHour>InpAsiaEndHour ? (h>=InpAsiaStartHour || h<InpAsiaEndHour) : (h>=InpAsiaStartHour && h<InpAsiaEndHour));
   bool lon=(InpLondonStartHour>InpLondonEndHour ? (h>=InpLondonStartHour || h<InpLondonEndHour) : (h>=InpLondonStartHour && h<InpLondonEndHour));
   bool ny=(InpNewYorkStartHour>InpNewYorkEndHour ? (h>=InpNewYorkStartHour || h<InpNewYorkEndHour) : (h>=InpNewYorkStartHour && h<InpNewYorkEndHour));
   if(asia && InpEnableAsia) return 0;
   if(lon && InpEnableLondon) return 1;
   if(ny && InpEnableNewYork) return 2;
   return -1;
}

bool IsNewBar()
{
   datetime t=iTime(InpSymbol,InpSignalTimeframe,0);
   if(t<=0 || t==lastBarTime) return false;
   lastBarTime=t;
   return true;
}

bool HasOurPosition()
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i);
      if(ticket>0 && PositionGetString(POSITION_SYMBOL)==InpSymbol && (ulong)PositionGetInteger(POSITION_MAGIC)==InpMagic) return true;
   }
   return false;
}

int VolumeDigits(double step)
{
   for(int n=0;n<=8;n++) if(MathAbs(step-NormalizeDouble(step,n))<1e-9) return n;
   return 2;
}

double NormalizeLots(double lots)
{
   double vmin=SymbolInfoDouble(InpSymbol,SYMBOL_VOLUME_MIN);
   double vmax=SymbolInfoDouble(InpSymbol,SYMBOL_VOLUME_MAX);
   double step=SymbolInfoDouble(InpSymbol,SYMBOL_VOLUME_STEP);
   if(step<=0 || vmin<=0) return 0;
   // Preserve the requested fixed lot; reject if broker constraints cannot accept it.
   if(lots<vmin-1e-9 || lots>vmax+1e-9) return 0;
   double aligned=MathFloor((lots-vmin)/step+1e-8)*step+vmin;
   if(MathAbs(aligned-lots)>1e-7) return 0;
   return NormalizeDouble(lots,VolumeDigits(step));
}

bool OpenTrade(int direction,double stopDistance)
{
   double lots=NormalizeLots(InpLots);
   if(lots<=0) { Print("Fixed lot is not valid for broker volume limits/step."); return false; }
   double ask=SymbolInfoDouble(InpSymbol,SYMBOL_ASK);
   double bid=SymbolInfoDouble(InpSymbol,SYMBOL_BID);
   double point=SymbolInfoDouble(InpSymbol,SYMBOL_POINT);
   int digits=(int)SymbolInfoInteger(InpSymbol,SYMBOL_DIGITS);
   if(ask<=0 || bid<=0 || point<=0) return false;
   double entry=(direction>0 ? ask : bid);
   double sl=(direction>0 ? entry-stopDistance : entry+stopDistance);
   double tp=(direction>0 ? entry+InpRewardRisk*stopDistance : entry-InpRewardRisk*stopDistance);
   sl=NormalizeDouble(sl,digits); tp=NormalizeDouble(tp,digits);
   long stopsLevel=SymbolInfoInteger(InpSymbol,SYMBOL_TRADE_STOPS_LEVEL);
   if(stopsLevel>0 && stopDistance < stopsLevel*point)
   { Print("Trade skipped: broker minimum stop distance exceeds configured stop."); return false; }
   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(InpDeviationPoints);
   trade.SetTypeFillingBySymbol(InpSymbol);
   bool ok=false;
   if(direction>0) ok=trade.Buy(lots,InpSymbol,0.0,sl,tp,"Anna 2R long");
   else            ok=trade.Sell(lots,InpSymbol,0.0,sl,tp,"Anna 2R short");
   if(!ok) PrintFormat("Order failed: retcode=%u (%s)",trade.ResultRetcode(),trade.ResultRetcodeDescription());
   else PrintFormat("Anna order placed. Lots=%.2f stop=%.2f price units target=%.2fR; estimated commission/trade=$%.2f (broker setting only)",lots,stopDistance,InpRewardRisk,InpEstimatedCommissionUSDPerTrade);
   return ok;
}

void OnInitHistory()
{
   // Build current and most recently completed active-session range from closed bars.
   MqlRates bars[];
   ArraySetAsSeries(bars,false);
   int copied=CopyRates(InpSymbol,InpSignalTimeframe,1,1200,bars);
   if(copied<=0) return;
   currentSession=-1; haveRange=false; havePreviousSession=false;
   for(int i=0;i<copied;i++)
   {
      int s=GetSession(bars[i].time);
      if(s<0) continue;
      if(!haveRange) { currentSession=s; rangeHigh=bars[i].high; rangeLow=bars[i].low; haveRange=true; }
      else if(s!=currentSession)
      {
         previousHigh=rangeHigh; previousLow=rangeLow; havePreviousSession=true;
         currentSession=s; rangeHigh=bars[i].high; rangeLow=bars[i].low;
      }
      else { rangeHigh=MathMax(rangeHigh,bars[i].high); rangeLow=MathMin(rangeLow,bars[i].low); }
   }
}

int OnInit()
{
   if(InpSymbol=="" || InpLots<=0 || InpMinStopUSD<=0 || InpMaxStopUSD<InpMinStopUSD || InpRewardRisk<=0 || InpATRPeriod<2)
      return INIT_PARAMETERS_INCORRECT;
   if(!SymbolSelect(InpSymbol,true)) { Print("Cannot select symbol: ",InpSymbol); return INIT_FAILED; }
   atrHandle=iATR(InpSymbol,InpSignalTimeframe,InpATRPeriod);
   if(atrHandle==INVALID_HANDLE) { Print("Could not create ATR indicator."); return INIT_FAILED; }
   OnInitHistory();
   lastBarTime=iTime(InpSymbol,InpSignalTimeframe,0);
   Print("Anna EA initialized for ",InpSymbol,". Session hours use broker server time.");
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   if(atrHandle!=INVALID_HANDLE) IndicatorRelease(atrHandle);
}

void OnTick()
{
   if(_Symbol!=InpSymbol) { /* EA can still run when attached elsewhere, but trades only configured symbol. */ }
   if(!IsNewBar()) return;
   MqlRates b[];
   ArraySetAsSeries(b,true);
   if(CopyRates(InpSymbol,InpSignalTimeframe,0,3,b)<3) return;
   MqlRates c=b[1]; // last closed signal candle
   int s=GetSession(c.time);
   if(s<0) return;

   // On session transition, freeze the preceding active session's high/low.
   if(!haveRange)
   {
      currentSession=s; rangeHigh=c.high; rangeLow=c.low; haveRange=true; return;
   }
   bool newSession=(s!=currentSession);
   if(newSession)
   {
      previousHigh=rangeHigh; previousLow=rangeLow; havePreviousSession=true;
      currentSession=s; rangeHigh=c.high; rangeLow=c.low;
   }
   else { rangeHigh=MathMax(rangeHigh,c.high); rangeLow=MathMin(rangeLow,c.low); }
   if(newSession || !havePreviousSession || HasOurPosition()) return;

   double atr[]; ArraySetAsSeries(atr,true);
   if(CopyBuffer(atrHandle,0,1,1,atr)<1 || atr[0]<=0) return;
   double tick=SymbolInfoDouble(InpSymbol,SYMBOL_TRADE_TICK_SIZE);
   if(tick<=0) tick=SymbolInfoDouble(InpSymbol,SYMBOL_POINT);
   int direction=0; double stopDistance=0.0;

   // Anna-style BodyBreak: close beyond previous session extreme in candle direction.
   if(c.close>previousHigh && c.close>c.open)
   {
      direction=1;
      double referenceEntry=(MathAbs(c.close-c.open)>InpBigBodyATRMultiple*atr[0] ? (c.open+c.close)/2.0 : c.close);
      stopDistance=referenceEntry-(c.low-tick);
   }
   else if(c.close<previousLow && c.close<c.open)
   {
      direction=-1;
      double referenceEntry=(MathAbs(c.close-c.open)>InpBigBodyATRMultiple*atr[0] ? (c.open+c.close)/2.0 : c.close);
      stopDistance=(c.high+tick)-referenceEntry;
   }
   // Anna-style WickSweep reversal at prior session liquidity level.
   else if(c.high>previousHigh && c.close<=previousHigh)
   {
      direction=-1; stopDistance=(c.high+tick)-c.close;
   }
   else if(c.low<previousLow && c.close>=previousLow)
   {
      direction=1; stopDistance=c.close-(c.low-tick);
   }
   if(direction==0) return;
   if(stopDistance<InpMinStopUSD || stopDistance>InpMaxStopUSD)
   {
      PrintFormat("Signal ignored: stop %.2f price units is outside allowed %.2f-%.2f.",stopDistance,InpMinStopUSD,InpMaxStopUSD);
      return;
   }
   OpenTrade(direction,stopDistance);
}
