//+------------------------------------------------------------------+
//|                             EMA50_EMA200_DynamicSL_RR2_v3.mq5    |
//|                     Entry @ close of breakout candle, SL @ EMA20 |
//+------------------------------------------------------------------+
#property copyright "Copyright 2026, GapGPT"
#property version   "3.00"
#property strict

#include <Trade\Trade.mqh>

// --- Trading ---
input group "=== Trading Settings ==="
input double   InpLot            = 0.05;      // Lot Size
input double   InpRiskReward     = 2.0;       // RR (TP = SL * RR)
input int      InpMinSLPoints    = 10;        // Min SL (points): M1=10 M5=20 M15=40
input int      InpMaxSLPoints    = 800;       // Max SL (points)
input double   InpMaxSlippage    = 5.0;       // Max slippage vs close (points)
input ulong    InpMagicNumber    = 20261111;  // Magic Number

// --- Indicators ---
input group "=== Indicator Settings ==="
input int      InpFastPeriod     = 50;
input int      InpSlowPeriod     = 200;
input int      InpSLPeriod       = 20;

// --- Globals ---
CTrade   trade;
int      hFast, hSlow, hSL;
datetime g_lastBar = 0;

//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(20);
   trade.SetTypeFillingBySymbol(_Symbol);

   hFast = iMA(_Symbol, _Period, InpFastPeriod, 0, MODE_EMA, PRICE_CLOSE);
   hSlow = iMA(_Symbol, _Period, InpSlowPeriod, 0, MODE_EMA, PRICE_CLOSE);
   hSL   = iMA(_Symbol, _Period, InpSLPeriod,  0, MODE_EMA, PRICE_CLOSE);

   if(hFast == INVALID_HANDLE || hSlow == INVALID_HANDLE || hSL == INVALID_HANDLE)
   {
      Print("Indicator handle error");
      return(INIT_FAILED);
   }
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(hFast);
   IndicatorRelease(hSlow);
   IndicatorRelease(hSL);
}

//+------------------------------------------------------------------+
bool HasOpenPosition()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!PositionSelectByTicket(PositionGetTicket(i))) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == (long)InpMagicNumber)
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
void OnTick()
{
   datetime barTime = iTime(_Symbol, _Period, 0);
   if(barTime == g_lastBar) return;          // only once per new bar
   g_lastBar = barTime;

   if(HasOpenPosition()) return;

   // ---- Data: shift=1 => index 0 is the JUST-CLOSED breakout candle ----
   double e50[], e200[], e20[];
   ArraySetAsSeries(e50,  true);
   ArraySetAsSeries(e200, true);
   ArraySetAsSeries(e20,  true);

   if(CopyBuffer(hFast, 0, 1, 3, e50)  < 3) return;
   if(CopyBuffer(hSlow, 0, 1, 3, e200) < 3) return;
   if(CopyBuffer(hSL,   0, 1, 1, e20)  < 1) return;

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, _Period, 1, 1, r) < 1) return;

   double sigClose = r[0].close;   // close of the breakout candle
   double sigHigh  = r[0].high;
   double sigLow   = r[0].low;
   double ema20    = e20[0];       // EMA20 of the SAME breakout candle

   // ---- Cross detection on the breakout candle ----
   // e50[0] / e200[0] = breakout candle
   // e50[1] / e200[1] = candle before it
   bool crossUp   = (e50[1] <= e200[1] && e50[0] > e200[0]);
   bool crossDown = (e50[1] >= e200[1] && e50[0] < e200[0]);
   if(!crossUp && !crossDown) return;

   double pt     = _Point;
   double ask    = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid    = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double maxSlp = InpMaxSlippage * pt;

   if(crossUp)
   {
      // FILTER: EMA20 must be BELOW the breakout candle low
      if(ema20 >= sigLow) return;

      // SL = EMA20 of the breakout candle
      double sl   = ema20;
      double dist = sigClose - sl;          // measured from the CLOSE
      if(dist < InpMinSLPoints * pt || dist > InpMaxSLPoints * pt) return;

      // Guard: market must not have run too far past the close
      if(ask - sigClose > maxSlp) return;

      double tp = sigClose + dist * InpRiskReward;

      if(trade.Buy(InpLot, _Symbol, ask, sl, tp, "EMA50/200 BUY"))
         PrintFormat("BUY  close=%.5f SL=%.5f TP=%.5f dist=%.1f pts slip=%.1f",
                     sigClose, sl, tp, dist/pt, (ask - sigClose)/pt);
   }
   else
   {
      // FILTER: EMA20 must be ABOVE the breakout candle high
      if(ema20 <= sigHigh) return;

      double sl   = ema20;
      double dist = sl - sigClose;          // measured from the CLOSE
      if(dist < InpMinSLPoints * pt || dist > InpMaxSLPoints * pt) return;

      if(sigClose - bid > maxSlp) return;

      double tp = sigClose - dist * InpRiskReward;

      if(trade.Sell(InpLot, _Symbol, bid, sl, tp, "EMA50/200 SELL"))
         PrintFormat("SELL close=%.5f SL=%.5f TP=%.5f dist=%.1f pts slip=%.1f",
                     sigClose, sl, tp, dist/pt, (sigClose - bid)/pt);
   }
}
//+------------------------------------------------------------------+
