#property link      "https://www.mql5.com"
#property version   "1.00"

#include <Trade\Trade.mqh>
CTrade trade;

//--- Inputs
input group "=== Trading Settings ==="
input string   InpSymbol        = "EURUSD_o"; // نماد معاملاتی
input double   InpLotSize       = 0.05;       // حجم معامله (Lot)
input int      InpStopLoss      = 50;         // حد ضرر (پوینت)
input int      InpTakeProfit    = 100;        // حد سود (پوینت)

input group "=== Indicator Settings ==="
input int      InpEMAPeriod     = 50;         // دوره میانگین متحرک EMA
input int      InpADXPeriod     = 14;         // دوره ADX (برای فیلتر Both)
input double   InpADXThreshold  = 25.0;       // حد نصاب ADX

//--- Global Variables
int    ema_handle;
int    adx_handle;
datetime last_bar_time;
int    auto_gmt_offset = 0;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(20261111);
   
   // تشخیص خودکار ساعت بروکر
   auto_gmt_offset = CalculateBrokerGMTOffset();
   Print("Auto-detected Broker GMT Offset: ", auto_gmt_offset, " hours");

   // ایجاد هندل اندیکاتورها
   ema_handle = iMA(InpSymbol, PERIOD_CURRENT, InpEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   if(ema_handle == INVALID_HANDLE)
   {
      Print("Error creating EMA handle.");
      return(INIT_FAILED);
   }

   adx_handle = iADX(InpSymbol, PERIOD_CURRENT, InpADXPeriod);
   if(adx_handle == INVALID_HANDLE)
   {
      Print("Error creating ADX handle.");
      return(INIT_FAILED);
   }

   last_bar_time = 0;
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(ema_handle);
   IndicatorRelease(adx_handle);
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   // بررسی تشکیل کندل جدید
   datetime current_bar_time = iTime(InpSymbol, PERIOD_CURRENT, 0);
   if(current_bar_time == last_bar_time) return;

   // دریافت قیمت‌های EMA و ADX برای کندل بسته شده (Index 1)
   double ema_values[];
   double adx_values[];
   
   ArraySetAsSeries(ema_values, true);
   ArraySetAsSeries(adx_values, true);

   if(CopyBuffer(ema_handle, 0, 1, 2, ema_values) <= 0) return;
   if(CopyBuffer(adx_handle, 0, 1, 2, adx_values) <= 0) return;

   double close_price_1 = iClose(InpSymbol, PERIOD_CURRENT, 1);
   double close_price_2 = iClose(InpSymbol, PERIOD_CURRENT, 2);
   
   // منطق اصلی استراتژی (تقاطع EMA)
   bool original_buy_signal  = (close_price_2 < ema_values[1] && close_price_1 > ema_values[1]);
   bool original_sell_signal = (close_price_2 > ema_values[1] && close_price_1 < ema_values[1]);
   
   // فیلتر ADX (حالت Both)
   bool trend_strong = (adx_values[1] > InpADXThreshold);

   // اعمال منطق معکوس (Mirror Strategy):
   // اگر سیگنال اصلی خرید باشد، ما فروش می‌زنیم و برعکس!
   bool mirror_sell = original_buy_signal && trend_strong;
   bool mirror_buy  = original_sell_signal && trend_strong;

   // اجرای معامله در صورت عدم وجود پوزیشن باز در این ماجول
   if(PositionsTotal() == 0)
   {
      MqlTick latest_tick;
      if(!SymbolInfoTick(InpSymbol, latest_tick)) return;

      if(mirror_buy)
      {
         double ask = latest_tick.ask;
         double sl = ask - InpStopLoss * _Point;
         double tp = ask + InpTakeProfit * _Point;
         
         if(trade.Buy(InpLotSize, InpSymbol, ask, sl, tp, "Mirror Both Buy"))
         {
            last_bar_time = current_bar_time;
            Print("Mirror BUY executed at: ", ask);
         }
      }
      else if(mirror_sell)
      {
         double bid = latest_tick.bid;
         double sl = bid + InpStopLoss * _Point;
         double tp = bid - InpTakeProfit * _Point;
         
         if(trade.Sell(InpLotSize, InpSymbol, bid, sl, tp, "Mirror Both Sell"))
         {
            last_bar_time = current_bar_time;
            Print("Mirror SELL executed at: ", bid);
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Auto-detect Broker GMT Offset                                    |
//+------------------------------------------------------------------+
int CalculateBrokerGMTOffset()
{
   datetime server_time = TimeCurrent();
   datetime gmt_time    = TimeGMT();
   
   int diff_seconds = (int)(server_time - gmt_time);
   int diff_hours   = diff_seconds / 3600;
   
   // گرد کردن به نزدیک‌ترین ساعت استاندارد
   if(diff_seconds % 3600 >= 1800) diff_hours++;
   if(diff_seconds % 3600 <= -1800) diff_hours--;
   
   return diff_hours;
}
 
