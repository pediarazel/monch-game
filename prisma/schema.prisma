generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // مطمئن شوید که DATABASE_URL در متغیرهای محیطی شما تنظیم شده است
  // connection_string = env("DATABASE_URL") // اگر میخواهید مستقیم در اینجا تنظیم کنید
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  coins        Int           @default(0)
  createdAt    DateTime      @default(now())
  role         String        @default("USER")
  transactions Transaction[]
}

model Transaction {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  amount    Int
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// --- مدل Match اضافه شده است ---
model Match {
  id           String    @id
  status       String
  winnerColor  String?
  finishedAt   DateTime?
  playerColors Json
  betAmount    String
}
